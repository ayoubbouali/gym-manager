<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.gymmanager</groupId>
		<artifactId>gym-manager</artifactId>
		<version>1.0.0</version>
	</parent>
	<artifactId>gym-manager-frontend</artifactId>
	<packaging>jar</packaging>
	<name>gym-manager-frontend</name>
	<description>Angular UI packaged as a jar under /static, served by the backend</description>

	<properties>
		<!-- Skip the whole Angular build: -Dskip.installnodenpm -Dskip.npm -->
		<skipTests>false</skipTests>
	</properties>

	<build>
		<!-- The Angular build (dist/gym-manager) becomes classpath:/static/ -->
		<resources>
			<resource>
				<directory>dist/gym-manager</directory>
				<targetPath>static</targetPath>
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<configuration>
					<nodeVersion>${node.version}</nodeVersion>
					<!-- Node is installed locally in gym-manager-frontend/node (ignored by git) -->
					<installDirectory>${project.basedir}</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
					</execution>
					<execution>
						<id>npm-ci</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci --no-audit --no-fund</arguments>
						</configuration>
					</execution>
					<execution>
						<id>ng-build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<!-- Proxy flags are only meant for npm itself; ng rejects them -->
							<npmInheritsProxyConfigFromMaven>false</npmInheritsProxyConfigFromMaven>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<execution>
						<id>ng-test</id>
						<phase>test</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<skip>${skipTests}</skip>
							<!-- Proxy flags are only meant for npm itself; ng rejects them -->
							<npmInheritsProxyConfigFromMaven>false</npmInheritsProxyConfigFromMaven>
							<arguments>test -- --watch=false</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<filesets>
						<fileset>
							<directory>dist</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
