<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.gymmanager</groupId>
	<artifactId>gym-manager</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>gym-manager</name>
	<description>Gym Manager (monolithe multi-module)</description>

	<!-- Order matters: the backend jar embeds the frontend jar (classpath:/static/). -->
	<modules>
		<module>gym-manager-frontend</module>
		<module>gym-manager-backend</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<node.version>v24.22.3</node.version>
		<frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.gymmanager</groupId>
				<artifactId>gym-manager-frontend</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>${frontend-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
